<?xml version="1.0" encoding="utf-8"?>
<!--
    Accelerometer maxima of a recorded flight (variant of fragment_telemetry_mp_tab2, currently
    not referenced by the code): label / value rows for the three axes of the ADXL375 and
    ADXL345 accelerometers.
-->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/activity_vertical_margin"
    android:paddingLeft="@dimen/activity_horizontal_margin"
    android:paddingRight="@dimen/activity_horizontal_margin"
    android:paddingTop="@dimen/activity_vertical_margin">


    <TextView
        android:id="@+id/txtViewTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="10dp"
        android:fontFamily="sans-serif-black"
        android:text="@string/accelerometer_status"
        android:textSize="18sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accel_375x"
        android:id="@+id/txtViewAccel375x"
        android:layout_below="@+id/txtViewTitle"
        android:layout_alignParentLeft="true"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:id="@+id/txtViewAccel375xValue"
        android:layout_below="@+id/txtViewTitle"
        android:layout_alignParentRight="true"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accel_375y"
        android:id="@+id/txtViewAccel375y"
        android:layout_below="@+id/txtViewAccel375x"
        android:layout_alignParentLeft="true"
         />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/txtViewAccel375yValue"
        android:text=""
        android:layout_alignParentRight="true"
        android:layout_below="@+id/txtViewAccel375x"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accel_375z"
        android:id="@+id/txtViewAccel375z"
        android:layout_below="@+id/txtViewAccel375y"
        android:layout_alignParentLeft="true"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/txtViewAccel375zValue"
        android:text=""
        android:layout_alignParentRight="true"
        android:layout_below="@+id/txtViewAccel375y"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accel_345x"
        android:id="@+id/txtViewAccel345x"
        android:layout_below="@+id/txtViewAccel375z"
        android:layout_alignParentLeft="true"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/txtViewAccel345xValue"
        android:text=""
        android:layout_alignParentRight="true"
        android:layout_below="@+id/txtViewAccel375z"/>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accel_345y"
        android:id="@+id/txtViewAccel345y"
        android:layout_below="@+id/txtViewAccel345x"
        android:layout_alignParentLeft="true"
        />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/txtViewAccel345yValue"
        android:text=""
        android:layout_alignParentRight="true"
        android:layout_below="@+id/txtViewAccel345x"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/accel_345z"
        android:id="@+id/txtViewAccel345z"
        android:layout_below="@+id/txtViewAccel345yValue"
        android:layout_alignParentLeft="true"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/txtViewAccel345zValue"
        tools:text="0"
        android:layout_alignParentRight="true"
        android:layout_below="@+id/txtViewAccel345yValue"/>


</RelativeLayout>